rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBALS & HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Auth tokens NEVER contain custom claims. Use exists() on a trusted document.
    // Included bootstrap email for initial seeding.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["get.corp.je@gmail.com", "getcorp.je@gmail.com"] ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }
    
    // Admins include super admins
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "admin@trendit.com" ||
        request.auth.token.email == "admin@trendit.lb"
      );
    }

    // Vendors include admins
    function isVendor() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['vendor', 'admin', 'super_admin']
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Hardcoded Admin Override - Development only
    match /{document=**} {
      allow read, write: if isSuperAdmin() || (isSignedIn() && (
        request.auth.token.email == "admin@trendit.com" ||
        request.auth.token.email == "admin@trendit.lb"
      ));
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSuperAdmin() || isOwner(adminId);
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // PRODUCTS
    // -------------------------------------------------------------------------
    
    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'price', 'categoryId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.categoryId is string && data.categoryId.size() <= 100 &&
             (data.get('vendorId', '') is string) &&
             (data.get('stock', 0) is number) &&
             (data.get('feePercentage', 0) is number);
    }

    match /products/{productId} {
      allow read: if true; 
      allow create: if isVendor() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isVendor() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // VENDORS
    // -------------------------------------------------------------------------
    
    function isValidVendor(data) {
      return data.keys().hasAll(['name', 'email']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.matches('^.+@.+$') && data.email.size() <= 150;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isSuperAdmin() && isValidVendor(incoming()) && isValidId(vendorId);
      allow update: if isAdmin() && isValidVendor(incoming());
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // CATEGORIES
    // -------------------------------------------------------------------------
    
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // ORDERS
    // -------------------------------------------------------------------------
    
    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'orderTotal', 'status']) &&
             data.orderTotal is number && data.orderTotal >= 0 &&
             data.status in ['new', 'pending', 'processing', 'confirmed', 'dispatched', 'shipped', 'delivered', 'cancelled'] &&
             (data.customerId == request.auth.uid || data.customerId == 'guest');
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isVendor());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isVendor());
      allow create: if (isSignedIn() || true) && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if isVendor() && incoming().diff(existing()).affectedKeys().hasAny(['status', 'paymentStatus', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.matches('^.+@.+$') &&
             data.role in ['user', 'vendor', 'admin', 'super_admin'];
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (incoming().role == 'user' || incoming().email in ['get.corp.je@gmail.com', 'getcorp.je@gmail.com']); 
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'updatedAt', 'role']) && incoming().role == existing().role) ||
                     (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['role', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // CMS
    // -------------------------------------------------------------------------
    
    match /cms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
