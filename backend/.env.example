# Backend environment
PORT=4000
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=

# Path to a Firebase service account JSON key (Console > Project Settings >
# Service Accounts > Generate new private key). Used by firebase-admin to verify
# ID tokens and set the 2FA custom claim. Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Resend (https://resend.com) — used to send 2FA verification code emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@getservices.live
