# Backend environment
PORT=4000
CORS_ORIGIN=http://localhost:3000
# OpenAI — powers the shopper chatbot, the vendor pitch text and reading
# product details from a photo. Only the key is required; the rest have
# sensible defaults and exist so a model can be swapped without a code change.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Path to a Firebase service account JSON key (Console > Project Settings >
# Service Accounts > Generate new private key). Used by firebase-admin to verify
# ID tokens and set the 2FA custom claim. Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Resend (https://resend.com) — used to send 2FA verification code emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
