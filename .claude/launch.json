{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trendit-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port=3000"],
      "port": 3000
    },
    {
      "name": "marketplace-app-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "cwd": "apps/marketplace",
      "port": 8081
    }
  ]
}
