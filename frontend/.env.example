# NOTE: GEMINI_API_KEY does NOT belong here. AI features call the backend service
# (see ../backend), which is the only place that key should ever be configured —
# anything defined in the frontend build ships to every visitor's browser.

# VITE_BACKEND_URL: Base URL of the backend service that proxies Gemini calls
# (chat, elevator pitch, image analysis). Defaults to http://localhost:4000 in dev.
VITE_BACKEND_URL="http://localhost:4000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
